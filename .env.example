# Twitch (obligatorias)
BOT_USERNAME=nombre_de_tu_bot
BOT_TOKEN=oauth:reemplaza_este_token
CANAL=canal_sin_hash

# Servidor
PORT=3000
APP_URL=
DASHBOARD_ORIGIN=https://darkops-dasboard.netlify.app
ADMIN_TOKEN=
WS_TOKEN=
CHAT_TOKEN=

# Voz: auto usa Gemini; Puter y Google quedan como respaldos sucesivos
TTS_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Aoede
GEMINI_TTS_STYLE="cheerful, warm, spontaneous and natural Colombian woman from the Caribbean coast, with a subtle costeño accent, expressive conversational intonation, a lively medium pace and clear diction; sound human rather than robotic or like an announcer, and never caricature or exaggerate the accent"
GEMINI_COAST_VOICE=Kore
GEMINI_COAST_STYLE="an unmistakably feminine adult Colombian woman from Barranquilla, with a warm medium-low contralto register that never sounds masculine, confident and assertive yet playful, a slightly husky natural texture, quick conversational cadence, crisp articulation, expressive pitch movement and a subtle Caribbean Colombian accent; use natural pauses, never sound like an announcer, never caricature the accent, and never imitate or claim to be a real person"

# Puter: respaldo adicional. Solo PUTER_AUTH_TOKEN es necesario.
# Ejecuta `npm run puter:token` localmente para obtenerlo; tratalo como secreto.
PUTER_AUTH_TOKEN=
PUTER_TTS_ENDPOINT=https://api.puter.com/drivers/call
PUTER_TTS_PROVIDER=xai
PUTER_TTS_MODEL=
PUTER_TTS_VOICE=ara
PUTER_TTS_STYLE="Speak as a cheerful, warm and spontaneous adult Colombian woman from the Caribbean coast, with natural conversational rhythm, expressive intonation and clear diction. Sound human, never robotic or like an announcer, and do not imitate a real person."
PUTER_TTS_FORMAT=mp3
PUTER_TTS_ENGINE=neural
PUTER_TTS_ATTRIBUTION=

AI_MODEL=gemini-3.5-flash-lite
AI_MAX_PREGUNTA=220
AI_MAX_RESPUESTA=280
AI_TIMEOUT_MS=20000
AI_RETRIES=2
# Corrige solo el texto hablado; OBS conserva el mensaje original. Si falla,
# el audio continúa con el texto original. Usa el modelo de texto, no el TTS.
TTS_TEXT_CORRECTION_ENABLED=true
TTS_TEXT_CORRECTION_MODEL=gemini-3.5-flash-lite
TTS_TEXT_CORRECTION_TIMEOUT_MS=6000
TTS_TEXT_CORRECTION_CACHE_TTL_MS=21600000
TTS_TEXT_CORRECTION_CACHE_MAX=300
TTS_CONCURRENCY=2
TTS_REQUEST_TIMEOUT_MS=25000
TTS_JOB_TIMEOUT_MS=45000
TTS_RETRIES=2

# Fish Audio: voz alternada en !habla y disponible en !ia diomedes
FISH_API_KEY=
FISH_REFERENCE_ID=c23b3ac076b44c07918ed2c54addc2c5
FISH_TTS_MODEL=s2.1-pro-free
FISH_ATTRIBUTION="Voz IA no oficial inspirada en Diomedes Díaz · Fish Audio · modelo de saibormigue 369"
FISH_NARUTO_REFERENCE_ID=1412b58e859448d284f8f62391e82bd9
FISH_NARUTO_ATTRIBUTION="Voz IA no oficial inspirada en Naruto · Fish Audio · modelo de coach_frank1994"
FISH_CACHE_TTL_MS=3600000
FISH_CACHE_MAX=30

# Comportamiento
COOLDOWN_SEGUNDOS=10
SOLO_SUBS=false
MAX_CARACTERES=150
MAX_COLA=20
PLAYBACK_TIMEOUT_MS=90000
QUEUE_GENERATION_TIMEOUT_MS=100000
CHAT_MAX_NAME=30
CHAT_COOLDOWN_SEGUNDOS=5
CHAT_GLOBAL_COOLDOWN_SEGUNDOS=1
CHAT_LIMITE_DIARIO=200
CHAT_LIMITE_USUARIO_DIARIO=50

# Presupuesto antiabuso (mods omiten el cupo individual, no el global/diario)
FISH_COOLDOWN_SEGUNDOS=45
FISH_GLOBAL_COOLDOWN_SEGUNDOS=3
FISH_LIMITE_DIARIO=60
FISH_LIMITE_USUARIO_DIARIO=6
GEMINI_TTS_COOLDOWN_SEGUNDOS=60
GEMINI_TTS_GLOBAL_COOLDOWN_SEGUNDOS=22
GEMINI_TTS_LIMITE_DIARIO=9
GEMINI_TTS_LIMITE_USUARIO_DIARIO=2
PUTER_TTS_COOLDOWN_SEGUNDOS=60
PUTER_TTS_GLOBAL_COOLDOWN_SEGUNDOS=10
PUTER_TTS_LIMITE_DIARIO=30
PUTER_TTS_LIMITE_USUARIO_DIARIO=3
AI_COOLDOWN_SEGUNDOS=60
AI_GLOBAL_COOLDOWN_SEGUNDOS=4
AI_LIMITE_DIARIO=60
AI_LIMITE_USUARIO_DIARIO=5
TTS_TEXT_CORRECTION_GLOBAL_COOLDOWN_SEGUNDOS=1
TTS_TEXT_CORRECTION_LIMITE_DIARIO=150
TTS_TEXT_CORRECTION_LIMITE_USUARIO_DIARIO=25
USAGE_TIMEZONE=America/Bogota

# Control opcional de Render
RENDER_API_KEY=
RENDER_SERVICE_ID=
