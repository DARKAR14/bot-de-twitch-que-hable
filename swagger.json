{
  "openapi": "3.0.3",
  "info": {
    "title": "TTS Bot API",
    "version": "1.0.0",
    "description": "API para enviar TTS privado, ver o limpiar la cola y cambiar el diseño en tiempo real."
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Servidor local" }],
  "paths": {
    "/api/cola": {
      "get": {
        "summary": "Obtener cola de mensajes",
        "description": "Devuelve estado actual de la cola",
        "responses": {
          "200": {
            "description": "Cola actual",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer", "example": 2 },
                    "mensajes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "example": "abc123" },
                          "usuario": { "type": "string", "example": "juan" },
                          "mensaje": { "type": "string", "example": "hola" },
                          "rutaAudio": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cola": {
      "get": {
        "summary": "Obtener cola (alias)",
        "description": "Acceso legacy a cola",
        "responses": {
          "200": {
            "description": "Cola actual",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer", "example": 2 },
                    "mensajes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "example": "abc123" },
                          "usuario": { "type": "string", "example": "juan" },
                          "mensaje": { "type": "string", "example": "hola" },
                          "rutaAudio": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Limpiar cola",
        "description": "Vacía la cola y elimina entradas",
        "responses": {
          "200": {
            "description": "Operación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "mensaje": { "type": "string", "example": "Cola limpiada" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/config": {
      "get": {
        "summary": "Obtener configuración pública del chat privado",
        "responses": {
          "200": {
            "description": "Límites y estado de autenticación",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authRequired": { "type": "boolean" },
                    "maxName": { "type": "integer" },
                    "maxMessage": { "type": "integer" },
                    "cooldownSeconds": { "type": "integer" },
                    "voices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "label"],
                        "properties": {
                          "id": { "type": "string", "example": "naruto" },
                          "label": { "type": "string", "example": "Naruto · Fish Audio" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Enviar un mensaje privado a OBS",
        "description": "Recibe {name, message, voice}. OBS muestra name y message; el TTS reproduce únicamente message con el perfil indicado por voice. Puede requerir X-Chat-Token.",
        "security": [{}, { "ChatToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "message"],
                "properties": {
                  "name": { "type": "string", "example": "Invitado secreto" },
                  "message": { "type": "string", "example": "Este texto se escucha en OBS" },
                  "voice": {
                    "type": "string",
                    "enum": ["auto", "gemini", "diomedes", "naruto", "google"],
                    "default": "auto",
                    "example": "naruto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Mensaje agregado a la cola" },
          "400": { "description": "Campos inválidos" },
          "401": { "description": "Token incorrecto" },
          "429": { "description": "Cooldown, presupuesto agotado o cola llena" },
          "503": { "description": "La voz seleccionada no está configurada" }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Obtener configuración",
        "description": "Devuelve los valores actuales de UI + TTS",
        "responses": {
          "200": {
            "description": "Configuración actual",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "textColor": { "type": "string", "example": "#eb8352" },
                    "messageColor": { "type": "string", "example": "#f0f0f0" },
                    "background": { "type": "string", "example": "rgba(10, 10, 20, 0.92)" },
                    "borderColor": { "type": "string", "example": "#ea8352" },
                    "barGradient": { "type": "string", "example": "linear-gradient(90deg, #eb8352, #ea8352)" },
                    "voiceLang": { "type": "string", "example": "es-ES" },
                    "voiceRate": { "type": "number", "example": 1.05 },
                    "voicePitch": { "type": "number", "example": 1 }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Actualizar configuración UI/TTS",
        "description": "Guarda nuevo estilo de notificación y parámetros de voz",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "textColor": { "type": "string", "example": "#ff00ff" },
                  "messageColor": { "type": "string", "example": "#ffffff" },
                  "background": { "type": "string", "example": "#0f0f1f" },
                  "borderColor": { "type": "string", "example": "#00ffff" },
                  "barGradient": { "type": "string", "example": "linear-gradient(90deg, #ff00ff, #00ffff)" },
                  "voiceLang": { "type": "string", "example": "es-ES" },
                  "voiceRate": { "type": "number", "format": "float", "minimum": 0.5, "maximum": 2.0, "example": 1.2 },
                  "voicePitch": { "type": "number", "format": "float", "minimum": 0.0, "maximum": 2.0, "example": 1.1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuración actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "config": {
                      "type": "object",
                      "properties": {
                        "textColor": { "type": "string" },
                        "messageColor": { "type": "string" },
                        "background": { "type": "string" },
                        "borderColor": { "type": "string" },
                        "barGradient": { "type": "string" },
                        "voiceLang": { "type": "string" },
                        "voiceRate": { "type": "number" },
                        "voicePitch": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ChatToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Chat-Token"
      }
    }
  }
}
